{
	"info": {
		"_postman_id": "local-taskmanager-api",
		"name": "TaskManager API (Local)",
		"description": "Full Postman collection for TaskManager API running locally (Port 7138).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"P@ssword123\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"gender\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/Auth/Register",
							"host": ["{{base_url}}"],
							"path": ["api", "Auth", "Register"]
						}
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.isSuccess && jsonData.value.token){",
									"    pm.collectionVariables.set(\"token\", jsonData.value.token);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.value.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@taskmanager.com\",\n    \"password\": \"P@ssword123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/Auth/Login",
							"host": ["{{base_url}}"],
							"path": ["api", "Auth", "Login"]
						}
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{token}}\",\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/Auth/Refresh",
							"host": ["{{base_url}}"],
							"path": ["api", "Auth", "Refresh"]
						}
					}
				},
				{
					"name": "Revoke Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/Auth/Revoke",
							"host": ["{{base_url}}"],
							"path": ["api", "Auth", "Revoke"]
						}
					}
				}
			]
		},
		{
			"name": "Projects",
			"item": [
				{
					"name": "Create Project",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"My New Project\",\n    \"description\": \"A project to track development tasks\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/Projects",
							"host": ["{{base_url}}"],
							"path": ["api", "Projects"]
						}
					}
				},
				{
					"name": "Get All Projects",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/Projects",
							"host": ["{{base_url}}"],
							"path": ["api", "Projects"]
						}
					}
				},
				{
					"name": "Get Project By ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/Projects/1",
							"host": ["{{base_url}}"],
							"path": ["api", "Projects", "1"]
						}
					}
				},
				{
					"name": "Update Project",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Project Name\",\n    \"description\": \"Updated Description\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/Projects/1",
							"host": ["{{base_url}}"],
							"path": ["api", "Projects", "1"]
						}
					}
				},
				{
					"name": "Delete Project",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/Projects/1",
							"host": ["{{base_url}}"],
							"path": ["api", "Projects", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Tasks",
			"item": [
